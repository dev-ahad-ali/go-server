{
  "info": {
    "_postman_id": "7f3a1c2e-9b4d-4e5f-8a6b-1c2d3e4f5a6b",
    "name": "go-server API",
    "description": "Endpoints for the go-server ecommerce API. Set base_url to the HTTP_PORT from your .env file (default http://localhost:8080). Run Login first. Its test script saves the JWT to auth_token, which the protected product requests send as an Authorization Bearer header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"secret123\",\n  \"is_shop_owner\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Registers a user in Postgres. 201 returns the created user with its id. 400 if the body is not valid JSON, 500 if the insert fails."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.response.json();",
                  "if (typeof token === \"string\" && token.split(\".\").length === 3) {",
                  "    pm.collectionVariables.set(\"auth_token\", token);",
                  "    pm.test(\"auth_token saved\", () => {});",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "description": "Returns 201 with the access token as a JSON string. The credentials must match a row in the users table. The test script stores the token in auth_token for the protected product requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Returns 200 with all products from the in-memory store. Seeded with products 1 through 6."
          },
          "response": []
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const product = pm.response.json();",
                  "if (product && product.id) {",
                  "    pm.collectionVariables.set(\"product_id\", String(product.id));",
                  "    pm.test(\"product_id saved\", () => {});",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Orange Juice\",\n  \"description\": \"Freshly squeezed, 1 liter\",\n  \"price\": 4.99,\n  \"imageUrl\": \"https://example.com/orange-juice.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Requires Authorization: Bearer {{auth_token}}. 201 returns the created product. The test script stores the new id in product_id. 400 on a bad body, 401 without a valid token."
          },
          "response": []
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "{{product_id}}"
              ]
            },
            "description": "Returns 200 with the product. 400 if the id is not a number, 404 if no product has that id."
          },
          "response": []
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Orange Juice\",\n  \"description\": \"Freshly squeezed, 1.5 liters\",\n  \"price\": 5.49,\n  \"imageUrl\": \"https://example.com/orange-juice.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "{{product_id}}"
              ]
            },
            "description": "Requires Authorization: Bearer {{auth_token}}. Replaces the product with the given id. The server replies 201 with the message \"Product successfully created\" (its wording, not an error in this file)."
          },
          "response": []
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "{{product_id}}"
              ]
            },
            "description": "Requires Authorization: Bearer {{auth_token}}. 200 with the message \"Product deleted successfully\"."
          },
          "response": []
        }
      ]
    }
  ]
}
